{
  "name": "typebreak",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "TypeBreak — an adaptive typing tutor that runs entirely in the browser. Predefined lesson library, client-side BTS learning algorithm, IndexedDB progress, JSON backup and offline support.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node tools/serve.js",
    "serve": "node tools/serve.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:watch": "node --test --watch \"tests/*.test.js\"",
    "lessons:build": "node tools/build-lessons.js",
    "icons:build": "node tools/build-icons.js",
    "build": "node tools/build-lessons.js && node tools/build-icons.js",
    "lint:imports": "node tools/check-unused.js"
  },
  "keywords": [
    "typing",
    "tutor",
    "adaptive",
    "pwa",
    "offline",
    "indexeddb",
    "client-side"
  ],
  "license": "MIT"
}
